# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these in Project -> Settings -> Environment Variables.

# ---- Site -------------------------------------------------------------
# Public URL, no trailing slash. Used for canonical URLs, sitemap, schema.
# NOTE: NEXT_PUBLIC_* values are baked in at BUILD time - set before deploying.
NEXT_PUBLIC_SITE_URL=https://www.f99solution.com

# ---- Database ---------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/f99-solution
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/f99-solution?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/f99-solution

# ---- Admin authentication ---------------------------------------------
# Generate a secret:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
# Needed only when running behind a proxy that is not Vercel (Vercel sets this up itself).
# AUTH_TRUST_HOST=true

# Used ONLY by `npm run seed:admin` to create / reset the first admin user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
# ADMIN_NAME=Admin

# ---- Email (SMTP) -----------------------------------------------------
# Leave SMTP_HOST empty to skip sending (leads are still saved).
# Gmail: smtp.gmail.com / 587 / SMTP_SECURE=false / use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="F99 Solution <hello@example.com>"
# Where new-lead notifications are sent.
ADMIN_NOTIFY_EMAIL=admin@example.com

# ---- Analytics (each loads ONLY if set AND the visitor accepts cookies) --
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Stock photos (scripts/fetch-images.ts, npm run images:fetch). Free key: pixabay.com/api/docs/ ----
PIXABAY_API_KEY=
